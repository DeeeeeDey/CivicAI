# Email Dispatch Configuration (Supports SMTP, Gmail, or Resend)
# Option A: Gmail with App Password (easiest for testing)
# GMAIL_USER="your-email@gmail.com"
# GMAIL_APP_PASSWORD="your-16-char-app-password"

# Option B: Standard SMTP
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_USER="postmaster@your-domain.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="CivicAI Operations <notifications@your-domain.com>"

# Option C: Resend API
# RESEND_API_KEY="re_..."
# RESEND_FROM="CivicAI Updates <onboarding@resend.dev>"

# Note: If no email credentials are set, CivicAI automatically initializes an Ethereal SMTP
# test mailbox, printing real one-click web preview URLs to the server terminal for every dispatch.
